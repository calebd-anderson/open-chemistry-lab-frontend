{
  "name": "ics-499-front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ics-499-front-end --configuration production",
    "build:dev": "ng build ics-499-front-end --configuration development",
    "build:prod-opt": "ng build ics-499-front-end --configuration production --output-hashing=all --stats-json --verbose",
    "build:prod-min": "ng build ics-499-front-end --configuration production --stats-json",
    "analyze": "ng build --configuration production --stats-json && webpack-bundle-analyzer dist/stats.json",
    "analyze:quick": "ng build --configuration production --stats-json --webpack-stats-output-file=dist/stats.json && npx webpack-bundle-analyzer dist/stats.json dist/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@auth0/angular-jwt": "^5.0.2",
    "@types/gsap": "^1.20.2",
    "d3": "^7.9.0",
    "gsap": "^3.13.0",
    "rxjs": "~7.5.0",
    "subsink": "^1.0.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~3.10.0",
    "@types/node": "^26.5.1",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.0.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "postcss": "^8.5.3",
    "pug": "^3.0.2",
    "sass": "^1.102.0",
    "tailwindcss": "^4.1.12",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "6.0.3",
    "vitest": "^4.0.8",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.2"
  }
}
